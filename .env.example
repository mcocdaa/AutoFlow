# ============================================
# AutoFlow 环境配置 (示例)
# 复制为 .env 后按需修改: cp .env.example .env
# ============================================

# --------------------------------------------
# 运行环境
# --------------------------------------------
# development: 开发环境（本地运行）
# production: 生产环境（Docker 部署）
ENVIRONMENT=development

# --------------------------------------------
# 端口配置 (单一事实来源: 3001=后端 / 8001=前端)
# --------------------------------------------
BACKEND_EXTERNAL_PORT=3001
FRONTEND_EXTERNAL_PORT=8001
# 是否对外暴露数据库/Redis 端口 (默认 false)
EXPOSE_DB_PORT=false
EXPOSE_REDIS_PORT=false

# --------------------------------------------
# 容器内部配置
# --------------------------------------------
BACKEND_INTERNAL_PORT=3000
FRONTEND_INTERNAL_PORT=8000
NETWORK_NAME=autoflow-network
CONTAINER_PREFIX=autoflow

# --------------------------------------------
# 后端配置
# --------------------------------------------
HOST=0.0.0.0
LOG_LEVEL=INFO
API_VERSION=v1
APP_VERSION=0.1.0
SERVE_STATIC_FILES=false
STATIC_FILES_DIR=/app/static

# CORS 配置 (逗号分隔, * 表示全部允许)
CORS_ORIGINS=*

# --------------------------------------------
# 数据库配置
# --------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_USER=autoflow
DB_NAME=autoflow_db

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --------------------------------------------
# 前端配置
# --------------------------------------------
# 本地开发时 vite 代理 /api 的目标地址
VITE_API_PROXY_URL=http://localhost:3001

# 前端构建模式
# web: 启动 Web 开发服务器（演示/测试）
# build-only: 仅构建输出静态文件（CI用）
FRONTEND_BUILD_MODE=web

# --------------------------------------------
# Secrets (建议使用 secrets/ 目录 + *_FILE 注入)
# --------------------------------------------
SECRET_FALLBACK_MODE=default
