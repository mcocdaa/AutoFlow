# ============================================
# AutoFlow 环境配置模板
# 复制后按需修改: cp .env.example .env && vim .env
# ============================================

# ---------- 运行环境 ----------
# development: 本地进程开发; production: Docker 部署
ENVIRONMENT=development

# ---------- 服务端口 ----------
# 宿主机访问端口（容器内固定 3000，前端/API 同端口）
BACKEND_EXTERNAL_PORT=3001
# 本地模式后端绑定地址
HOST=0.0.0.0

# ---------- 后端 ----------
LOG_LEVEL=INFO
# CORS 允许来源（逗号分隔，* 表示全部允许）
CORS_ORIGINS=*

# ---------- 前端（仅本地开发） ----------
# 本地 dev server 代理 /api 的目标地址
VITE_API_PROXY_URL=http://localhost:3001

# ---------- 插件密钥（可选，留空则对应能力不可用） ----------
DEEPSEEK_API_KEY=
ZHIHU_COOKIE=
KNOWFLOW_BASE_URL=

# ---------- 插件 dry_run（可选，1/true/on 开启） ----------
AUTOFLOW_AI_DRY_RUN=
AUTOFLOW_ZHIHU_DRY_RUN=
AUTOFLOW_DESKTOP_DRY_RUN=
